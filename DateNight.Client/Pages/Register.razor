@page "/register"
@inject CookieAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>DateNight · Create account</PageTitle>

<div class="dn-auth">
    <h1>Create your account</h1>
    <p class="text-muted">Save itineraries and get back to them from any device.</p>

    <form @onsubmit="Submit" @onsubmit:preventDefault>
        <label class="form-label" for="email">Email</label>
        <input id="email" class="form-control mb-3" type="email" autocomplete="email" @bind="email" />
        <label class="form-label" for="pw">Password</label>
        <input id="pw" class="form-control mb-1" type="password" autocomplete="new-password" @bind="password" />
        <div class="form-text mb-3">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</div>
        <label class="form-label" for="pw2">Confirm password</label>
        <input id="pw2" class="form-control mb-3" type="password" autocomplete="new-password" @bind="confirm" />
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger py-2">
                @foreach (var e in errors)
                {
                    <div>@e</div>
                }
            </div>
        }
        <button class="btn btn-primary w-100" type="submit" disabled="@busy">@(busy ? "Creating…" : "Create account")</button>
    </form>

    <p class="mt-3 small">Already have an account? <a href="@($"login?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "")}")">Sign in</a></p>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string email = "", password = "", confirm = "";
    private List<string> errors = new();
    private bool busy;

    private async Task Submit()
    {
        errors = new();
        if (password != confirm) { errors.Add("Passwords don't match."); return; }

        busy = true;
        errors = await Auth.RegisterAsync(email.Trim(), password);
        if (errors.Count == 0)
        {
            var loginError = await Auth.LoginAsync(email.Trim(), password);
            if (loginError is null) { Nav.NavigateTo(Login.SafeReturn(ReturnUrl)); return; }
            errors.Add(loginError);
        }
        busy = false;
    }
}
