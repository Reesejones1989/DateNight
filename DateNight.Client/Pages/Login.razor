@page "/login"
@inject CookieAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>DateNight · Sign in</PageTitle>

<div class="dn-auth">
    <h1>Welcome back</h1>
    <p class="text-muted">Sign in to see and build your itineraries.</p>

    <form @onsubmit="Submit" @onsubmit:preventDefault>
        <label class="form-label" for="email">Email</label>
        <input id="email" class="form-control mb-3" type="email" autocomplete="email" @bind="email" />
        <label class="form-label" for="pw">Password</label>
        <input id="pw" class="form-control mb-3" type="password" autocomplete="current-password" @bind="password" />
        @if (error is not null)
        {
            <div class="alert alert-danger py-2">@error</div>
        }
        <button class="btn btn-primary w-100" type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
    </form>

    <p class="mt-3 small">New here? <a href="@($"register?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "")}")">Create an account</a></p>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string email = "", password = "";
    private string? error;
    private bool busy;

    private async Task Submit()
    {
        busy = true;
        error = await Auth.LoginAsync(email.Trim(), password);
        busy = false;
        if (error is null) Nav.NavigateTo(SafeReturn(ReturnUrl));
    }

    // Only allow redirects within this app.
    internal static string SafeReturn(string? url) =>
        string.IsNullOrWhiteSpace(url) || url.Contains("://") || url.StartsWith("//") || url.StartsWith("login") || url.StartsWith("register")
            ? "itineraries"
            : url.TrimStart('/');
}
